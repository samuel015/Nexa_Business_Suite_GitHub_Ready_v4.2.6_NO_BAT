# Copy this file to .env and replace the placeholder passwords.
SPRING_PROFILES_ACTIVE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexa_business
DB_URL=jdbc:mariadb://127.0.0.1:3306/nexa_business
DB_USERNAME=nexa
DB_PASSWORD=replace-with-local-db-password

# Used only by Docker Compose helpers.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
POSTGRES_PASSWORD=replace-with-local-postgres-password

APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
DB_POOL_SIZE=10
